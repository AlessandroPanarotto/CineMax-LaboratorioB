<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.uninsubria.cinemax</groupId>
  <artifactId>cinemax</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>CineMax</name>
  <description>
    Laboratorio Interdisciplinare B (a.a. 2025/2026) - Universita' degli Studi dell'Insubria.
    Sistema di gestione di un cinema monosala: palinsesto e prenotazioni,
    con back-end serverCM su PostgreSQL/JDBC e client clientCM (RMI + Swing).
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <postgresql.version>42.7.4</postgresql.version>
  </properties>

  <dependencies>
    <!-- Driver JDBC per PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>cinemax</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Genera la javadoc in target/site/apidocs (mvn javadoc:javadoc) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <doclint>none</doclint>
        </configuration>
      </plugin>

      <!--
        maven-assembly-plugin: con "mvn package" produce due jar eseguibili
        distinti dentro la cartella bin/ del progetto:
          - bin/serverCM.jar : contiene anche il driver JDBC di PostgreSQL
            (descrittore predefinito "jar-with-dependencies"), perche' e'
            l'unico a parlare col database. Main-Class: cinemax.server.ServerMain
          - bin/clientCM.jar : NON contiene il driver JDBC (non gli serve,
            il client parla solo via RMI), usa il descrittore scritto a
            mano in src/assembly/client-jar.xml. Main-Class: cinemax.client.ClientMain
        Ogni <execution> qui sotto rappresenta la creazione di uno dei due jar.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>build-server-jar</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptorRefs>
                <descriptorRef>jar-with-dependencies</descriptorRef>
              </descriptorRefs>
              <archive>
                <manifest>
                  <mainClass>cinemax.server.ServerMain</mainClass>
                </manifest>
              </archive>
              <finalName>serverCM</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>${project.basedir}/bin</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>build-client-jar</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/client-jar.xml</descriptor>
              </descriptors>
              <archive>
                <manifest>
                  <mainClass>cinemax.client.ClientMain</mainClass>
                </manifest>
              </archive>
              <finalName>clientCM</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>${project.basedir}/bin</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
